# Local AI stack example configuration
# Copy this file to .env in ai-stack/ when you need custom settings.
# Never commit the real .env file or any access tokens/passwords.
# Docker Compose also works without .env using its built-in defaults.

TZ=Etc/UTC

# Do not put authentication passwords here unless the application explicitly
# supports that setting. Configure n8n's owner account in the n8n web UI.
# Never expose these local services directly to the public internet.
