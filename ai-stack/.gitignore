# =============================================================================
# AI Stack .gitignore
# =============================================================================

# Data directories (persistent volumes)
data/
shared/

# Environment files with secrets (including the local .env)
.env
.env.*
!.env.example


# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Backup files
*.bak
*.backup
backups/